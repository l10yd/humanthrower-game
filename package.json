{
  "name": "humanthrower",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "HUMAN THROWER - physics-based ragdoll / falling-body / row-clearing arcade game. You control the human who survives underneath the falling ones.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
